{
    "name": "mhm/ui-core",
    "description": "Shared WordPress UI infrastructure for MHM plugins: component factory, React admin kit, free-core/Pro tier seam.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MHMUiCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MHMUiCore\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "@php ./vendor/bin/phpunit -c phpunit.xml",
        "phpcs": "@php ./vendor/bin/phpcs --standard=phpcs.xml",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "check:php-namespace": "@php ./bin/check-php-namespace.php",
        "check:error-prefix": "@php ./bin/check-error-prefix.php",
        "check:no-i18n": "@php ./bin/check-no-i18n.php",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test",
            "@check:php-namespace",
            "@check:error-prefix",
            "@check:no-i18n"
        ]
    }
}
