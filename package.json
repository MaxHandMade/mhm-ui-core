{
	"name": "@mhm/ui-core",
	"version": "0.27.3",
	"description": "Shared WordPress admin React modules for MHM plugins.",
	"license": "GPL-2.0-or-later",
	"sideEffects": false,
	"files": [
		"src-react",
		"!src-react/**/*.test.js",
		"!src-react/**/*.test.jsx",
		"!src-react/kit-classes.json"
	],
	"scripts": {
		"test": "wp-scripts test-unit-jest",
		"lint:js": "wp-scripts lint-js src-react --max-warnings=0",
		"check:css-namespace": "node bin/check-css-namespace.mjs",
		"tokens:build": "node bin/build-tokens.js",
		"tokens:check": "node bin/build-tokens.js --check"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/parser": "^7.29.12",
		"@testing-library/react": "16.3.3",
		"@wordpress/babel-preset-default": "8.55.0",
		"@wordpress/element": "6.46.0",
		"@wordpress/eslint-plugin": "28.2.0",
		"@wordpress/jest-preset-default": "14.2.0",
		"@wordpress/scripts": "37.2.0",
		"babel-jest": "30.5.0",
		"eslint": "10.15.0",
		"eslint-plugin-jest": "29.17.1",
		"jest": "30.5.0",
		"jest-environment-jsdom": "30.5.0",
		"postcss": "8.5.32",
		"stylelint": "^16.26.1",
		"typescript": "^6.0.3"
	},
	"main": "src-react/index.js",
	"exports": {
		".": "./src-react/index.js",
		"./tokens.json": "./src-react/tokens.json",
		"./src-react/*": "./src-react/*"
	},
	"peerDependencies": {
		"@wordpress/element": ">=6"
	},
	"overrides": {
		"serialize-javascript@<7.1.3": "^7.1.4",
		"js-yaml@>=5.0.0 <=5.4.0": "^5.4.1",
		"smol-toml@<=1.8.0": "^1.9.1",
		"@jest/reporters": {
			"glob": "^14.0.6"
		},
		"jest-config": {
			"glob": "^14.0.6"
		},
		"jest-runtime": {
			"glob": "^14.0.6"
		},
		"test-exclude": {
			"glob": "^14.0.6",
			"minimatch": "^11.0.9"
		},
		"markdownlint-cli": {
			"minimatch": "^11.0.9"
		},
		"micromark-extension-math": {
			"katex": "^0.18.2"
		}
	}
}
