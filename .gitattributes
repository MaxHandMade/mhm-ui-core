# Keep LF in the working tree on every platform. Without this, git's autocrlf
# rewrites PHP files to CRLF on Windows checkout and PHPCS fails locally
# (Generic.Files.LineEndings.InvalidEOLChar) while CI on Linux stays green —
# a local/CI divergence that costs a debugging round every time it resurfaces.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# ---------------------------------------------------------------------------
# SHIPPED SURFACE: AN ALLOWLIST, NOT A BLACKLIST
#
# Two archivers read these lines. A GitHub codeload/release archive runs
# `git archive`; `composer archive` (and Satis / Private Packagist) parses this
# file itself -- and its `/*` does not match dotfiles, which is why `/.*` is a
# line of its own (Fable, PR #55: without it .github/ and the lint configs
# shipped, 83 files against git's 76). ShippedSurfaceTest measures both. What
# survives lands in every consumer's vendor/mhm/ui-core. The root is closed by default and only the
# entries below are opened again, so a file nobody named -- a notes file, a
# new tool config, a window card, a build/ directory -- stays out on its own
# instead of shipping in silence until someone notices and adds a line.
#
# Inside src/, src-react/ and assets/ the allowlist is tests/shipped-files.txt
# (ShippedSurfaceTest compares the archive to it by name). A git pattern such
# as `/src/**` cannot do that job: it also matches the subdirectories, and git
# archive skips an export-ignored directory whole.
#
# This does NOT reach the npm tarball -- `npm pack` ignores export-ignore --
# so package.json carries its own allowlist in "files".
# ---------------------------------------------------------------------------
/*                export-ignore
/.*               export-ignore

/LICENSE          -export-ignore
/README.md        -export-ignore
/README-tr.md     -export-ignore
/bootstrap.php    -export-ignore
/register.php     -export-ignore
/composer.json    -export-ignore
/src              -export-ignore
/src-react        -export-ignore
/assets           -export-ignore

# package.json ships on purpose. It looks like tooling, but webpack reads the
# nearest package.json for "sideEffects" when it bundles src-react/ -- the
# consumer imports those modules by relative path into its own build. Dropping
# it would silently disable tree shaking for this package's modules. The
# consumer's .distignore keeps it out of the plugin ZIP; by then the bundle is
# already built.
/package.json     -export-ignore

# Inside an allowlisted directory, test files stay out: Rentiva's
# check-js-correctness reported 95 no-undef findings from this package's
# *.test.js files, because jest globals are undefined in a consumer's ESLint
# config.
*.test.js         export-ignore
*.test.jsx        export-ignore

# Gate 6's CI contract (bin/dump-kit-classes.php writes it, tests/Gate/kit-
# parity.test.js and tests/ShippedSurfaceTest.php read it). Nothing at runtime
# reads it. package.json "files" excludes it from the npm side.
/src-react/kit-classes.json export-ignore
