# Keep LF in the working tree on every platform. Without this, git's autocrlf
# rewrites PHP files to CRLF on Windows checkout and PHPCS fails locally
# (Generic.Files.LineEndings.InvalidEOLChar) while CI on Linux stays green —
# a local/CI divergence that costs a debugging round every time it resurfaces.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Keep development-only files out of the composer/npm archive. A consumer that
# installs this package gets vendor/mhm/ui-core inside its own tree, and its
# gates lint what they find there: Rentiva's check-js-correctness reported 95
# no-undef findings from THIS package's *.test.js files, because jest globals
# are undefined in the consumer's ESLint config. The package has no business
# shipping its own test suite to a consumer's vendor directory.
/tests/            export-ignore
/.github/          export-ignore
*.test.js          export-ignore
*.test.jsx         export-ignore
/jest.config.js    export-ignore
/.eslintrc.js      export-ignore
/phpcs.xml         export-ignore
/phpstan.neon      export-ignore
/phpunit.xml       export-ignore
/package-lock.json export-ignore
/.gitattributes    export-ignore
/bin/              export-ignore
/bin/check-error-prefix.php export-ignore
/bin/check-no-i18n.php export-ignore
/.stylelintrc.json export-ignore
/docker/           export-ignore
/phpunit-integration.xml export-ignore

# .gitignore has no role in a consumer's tree: it is git metadata for THIS
# repository, and a consumer installs this package as files, not as a clone.
# It was the last dev-only file still landing in vendor/mhm/ui-core, which
# meant every consumer's .distignore had to name it to keep it out of the ZIP.
# Excluding it here fixes that once, at the source, instead of once per product.
/.gitignore        export-ignore

# The window cards are harness metadata for THIS repository -- CLAUDE.md for
# Claude Code, AGENTS.md for Codex. A consumer installs this package as files
# into vendor/mhm/ui-core, where a card pointing at this repo's memory notebook
# means nothing. CLAUDE.md landing in the archive is what pushed the shipped
# surface from 52 to 53 and turned CI red on 2026-09-04; AGENTS.md is named
# here too so the same break cannot happen the day that card gets tracked.
/CLAUDE.md         export-ignore
/AGENTS.md         export-ignore

# package.json deliberately does NOT get export-ignore. It looks like tooling,
# but webpack reads the nearest package.json for "sideEffects": false when it
# bundles src-react/ — the consumer imports those modules by relative path into
# its own build. Dropping it from the archive would silently disable tree
# shaking for this package's modules. The consumer's .distignore is the right
# place to keep it out of the shipped ZIP: by then the bundle is already built.
