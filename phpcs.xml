<?xml version="1.0"?>
<ruleset name="MHM UI Core">
	<description>WordPress Coding Standards for mhm/ui-core.</description>

	<!--
	register.php and bootstrap.php are listed explicitly, not just <file>src</file>:
	they hold every global this package declares (both functions, the global
	variable, both constants), so leaving them out made the PrefixAllGlobals rule
	below blind to the only code it exists to check. src/ alone is namespaced,
	and namespaced code is exempt from that sniff.
	-->
	<file>src</file>
	<file>register.php</file>
	<file>bootstrap.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress-Core">
		<!--
		This package is composer/PSR-4 autoloaded (see autoload.psr-4 in
		composer.json), not classically included by WordPress. PSR-4 requires
		the file name to match the class name exactly (VersionSelector.php for
		class VersionSelector); WordPress's class-{name}.php / hyphenated-
		lowercase file-naming convention would break autoloading. Excluded
		deliberately, not an oversight.
		-->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mhmuicore"/>
				<element value="MHMUiCore"/>
			</property>
		</properties>
	</rule>

	<config name="testVersion" value="8.1-"/>
</ruleset>
