<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="false"
    cacheResult="false"
    failOnEmptyTestSuite="true"
>
    <testsuites>
        <testsuite name="MHM UI Core">
            <directory suffix="Test.php">./tests/</directory>
            <!--
            tests/Integration needs a running WordPress and a database. It has
            its own configuration file (phpunit-integration.xml) and its own
            bootstrap; leaving it in here would make `composer test` fail on any
            machine that has PHP and nothing else.
            -->
            <exclude>./tests/Integration</exclude>
        </testsuite>
    </testsuites>
</phpunit>
