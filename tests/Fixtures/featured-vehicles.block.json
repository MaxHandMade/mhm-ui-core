{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mhm-rentiva/featured-vehicles",
    "title": "MHM Featured Vehicles",
    "category": "widgets",
    "icon": "star-filled",
    "description": "Display featured vehicles as a carousel.",
    "textdomain": "mhm-rentiva",
    "supports": {
        "html": false,
        "anchor": true,
        "className": true,
        "customClassName": true,
        "align": [
            "wide",
            "full",
            "center"
        ],
        "color": {
            "text": true,
            "background": true,
            "link": true,
            "gradients": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontFamily": true,
            "__experimentalFontWeight": true
        }
    },
    "attributes": {
        "layout": {
            "type": "string",
            "default": "slider"
        },
        "showPrice": {
            "type": "boolean",
            "default": true
        },
        "showRating": {
            "type": "boolean",
            "default": true
        },
        "showCategory": {
            "type": "boolean",
            "default": true
        },
        "showBookButton": {
            "type": "boolean",
            "default": true
        },
        "showFeatures": {
            "type": "boolean",
            "default": true
        },
        "showBrand": {
            "type": "boolean",
            "default": false
        },
        "showAvailability": {
            "type": "boolean",
            "default": false
        },
        "showCompareButton": {
            "type": "boolean",
            "default": true
        },
        "showBadges": {
            "type": "boolean",
            "default": true
        },
        "showFavoriteButton": {
            "type": "boolean",
            "default": true
        },
        "filterCategories": {
            "type": "string",
            "default": ""
        },
        "sortBy": {
            "type": "string",
            "default": "date",
            "enum": [
                "date",
                "title",
                "price",
                "popularity",
                "newest",
                "rating"
            ]
        },
        "sortOrder": {
            "type": "string",
            "default": "desc",
            "enum": [
                "asc",
                "desc"
            ]
        },
        "limit": {
            "type": "string",
            "default": "6"
        },
        "columns": {
            "type": "string",
            "default": "3"
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "ids": {
            "type": "string",
            "default": ""
        },
        "category": {
            "type": "string",
            "default": ""
        },
        "autoplay": {
            "type": "boolean",
            "default": true
        },
        "interval": {
            "type": "string",
            "default": "5000"
        },
        "showBookingButton": {
            "type": "boolean",
            "default": true
        },
        "maxFeatures": {
            "type": "string",
            "default": "5"
        },
        "imageSize": {
            "type": "string",
            "default": "large"
        },
        "priceFormat": {
            "type": "string",
            "default": "daily"
        },
        "viewAllUrl": {
            "type": "string",
            "default": ""
        },
        "viewAllText": {
            "type": "string",
            "default": ""
        },
        "className": {
            "type": "string",
            "default": ""
        }
    },
    "editorStyle": [
        "mhm-rentiva-core-variables"
    ],
    "style": [
        "mhm-rentiva-featured-vehicles"
    ]
}
